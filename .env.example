DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_knowledge"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
OPENAI_API_KEY=
# Local assistant replies use Ollama. Install Ollama and pull the configured model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
# Demo guest/admin access is enabled automatically outside production.
# Set to false to disable it, or true to opt in explicitly.
ENABLE_DEMO_ACCESS=true
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For production, replace CLIENT_ORIGINS with your deployed app origin(s).
